# Saarvi — Production Environment Template
# Copy this file to .env.local for local development: cp .env.example .env.local
# DO NOT commit real secrets or credentials to source control.

# =========================================================================
# 1. APPLICATION DOMAIN & ENVIRONMENT
# =========================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://saarvi.app

# =========================================================================
# 2. SUPABASE AUTHENTICATION & SSR CONFIGURATION
# =========================================================================
# Obtain from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional: Server-only service role key for administrative tasks (NEVER NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =========================================================================
# 3. CASHFREE PRODUCTION PAYMENT GATEWAY (REAL-MONEY PAYMENTS)
# =========================================================================
# Obtain from Cashfree Dashboard -> Developers -> API Keys
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
# Set to 'SANDBOX' for testing / 'PRODUCTION' for real payments
CASHFREE_ENVIRONMENT=SANDBOX
# Cashfree PG API Version (default: 2023-08-01)
CASHFREE_API_VERSION=2023-08-01

# Legacy Payment Placeholders (Deprecated)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# =========================================================================
# 4. TRANSACTIONAL EMAIL (GMAIL SMTP)
# =========================================================================
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user_email_here
SMTP_PASS=your_16_char_app_password_here
EMAIL_FROM_EMAIL=notifications@saarvi.app
EMAIL_FROM_NAME=Saarvi

# Optional: Resend API Key (alternative provider fallback)
RESEND_API_KEY=your_resend_api_key_here

# Optional: WhatsApp Cloud API (decoupled reminder channel)
WHATSAPP_API_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# =========================================================================
# 5. AI & OCR INTELLIGENT DOCUMENT LAYER (OPTIONAL SERVER-SIDE)
# =========================================================================
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
AI_API_KEY=your_ai_api_key_here
AI_TEXT_MODEL=gemini-3.6-flash
OCR_PROVIDER=gemini
OCR_API_KEY=your_ocr_api_key_here
AI_VISION_MODEL=gemini-3.6-flash
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct

# =========================================================================
# 5B. MANUAL UPI DIRECT PAYMENT CONFIGURATION
# =========================================================================
UPI_VPA=9036745164-3@axl
AI_TIMEOUT_MS=25000
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_CONTEXT_MESSAGES=10
AI_RATE_LIMIT=30

# =========================================================================
# 6. SEO & SEARCH CONSOLE OWNERSHIP VERIFICATION
# =========================================================================
# Token extracted from Google Search Console HTML tag verification
GOOGLE_SITE_VERIFICATION=your_google_site_verification_token_here

# =========================================================================
# 7. CAREER & JOBS DISCOVERY ENGINE (STRICTLY SERVER-SIDE)
# =========================================================================
SERPAPI_API_KEY=your_serpapi_api_key_here

