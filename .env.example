# Saarvi — Production Environment Template
# Copy this file to .env.local for local development: cp .env.example .env.local
# DO NOT commit real secrets or credentials to source control.

# =========================================================================
# 1. APPLICATION DOMAIN & ENVIRONMENT
# =========================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://saarvi.app

# =========================================================================
# 2. SUPABASE AUTHENTICATION & SSR CONFIGURATION
# =========================================================================
# Obtain from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Optional: Server-only service role key for administrative tasks (NEVER NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# =========================================================================
# 3. RAZORPAY BILLING & PAYMENT GATEWAY
# =========================================================================
# Provider selection: 'razorpay' for production / staging
BILLING_PROVIDER=razorpay
# Razorpay Key ID (public key safe for client checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
# Razorpay Key ID & Key Secret (server-authoritative)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Webhook secret configured in Razorpay Dashboard for HMAC signature verification
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# Plan IDs created in Razorpay Dashboard for Pro subscriptions (₹99/mo, ₹899/yr)
RAZORPAY_PRO_MONTHLY_PLAN_ID=plan_your_monthly_plan_id
RAZORPAY_PRO_YEARLY_PLAN_ID=plan_your_yearly_plan_id

# =========================================================================
# 4. TRANSACTIONAL EMAIL (GMAIL SMTP)
# =========================================================================
# Provider selection: 'gmail' (default) or 'resend'
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Google Account & 16-character App Password (from myaccount.google.com/apppasswords)
SMTP_USER=notifications@saarvi.app
SMTP_PASS=your-google-app-password
EMAIL_FROM_EMAIL=notifications@saarvi.app
EMAIL_FROM_NAME=Saarvi

# Optional: Resend API Key (alternative provider fallback)
RESEND_API_KEY=

# Optional: WhatsApp Cloud API (decoupled reminder channel)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# =========================================================================
# 5. AI & OCR INTELLIGENT DOCUMENT LAYER (OPTIONAL SERVER-SIDE)
# =========================================================================
# Provider selection: 'gemini', 'openrouter', or empty for local-only
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_TEXT_MODEL=gemini-1.5-flash
OCR_PROVIDER=gemini
OCR_API_KEY=your_gemini_vision_api_key_here
AI_VISION_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=
